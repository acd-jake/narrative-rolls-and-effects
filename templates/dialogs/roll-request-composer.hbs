<div class="roe-gm-request-form">
  <div class="launcher-mode-tabs composer-tabs">
    {{#each tabs}}
      <button type="button" class="tab-btn {{#if active}}active{{/if}}" data-action="selectType" data-type="{{id}}">
        <i class="fa-solid {{icon}}"></i> {{label}}
      </button>
    {{/each}}
  </div>

  {{{requestContent}}}

  <button type="button" class="prompt-action-btn primary" data-action="dispatchRequest">
    <i class="fa-solid fa-paper-plane"></i> {{localize "ROE.RollRequest.SendBtn"}}
  </button>
</div>
