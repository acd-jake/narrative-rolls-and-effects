<div class="roe-roll-prompt-frame" style="background-color: {{themeBackgroundColor}}; background-image: url('modules/narrative-rolls-and-effects/assets/ui/{{theme}}/frame.svg');">
    <button type="button" class="prompt-close-btn" data-action="closePrompt" title="{{localize 'ROE.RollSession.Close'}}">
        <i class="fa-solid fa-xmark"></i>
    </button>
    <header class="prompt-header prompt-drag-handle">
        <div class="prompt-skill-name">{{resolvedTitle}}</div>
    </header>
    <div class="prompt-sub-box">
        {{#each resolvedParticipants}}
        <div class="combined-check-row">
            <span>{{actorName}}{{#if actorName}}: {{/if}}{{label}}</span>
            <strong {{#if canView}}data-inspect-key="{{key}}"{{/if}}>{{result}}</strong>
        </div>
        {{/each}}
    </div>
    {{#if resolvedHeadline}}
    <div class="prompt-outcome-banner">{{resolvedHeadline}}</div>
    {{/if}}
</div>
