<div class="roe-roll-prompt-frame">
    <button type="button" class="prompt-close-btn" data-action="closePrompt" title="{{localize 'ROE.RollSession.Close'}}">
        <i class="fa-solid fa-xmark"></i>
    </button>
    <header class="prompt-header prompt-drag-handle">
        <div class="prompt-skill-name">{{resolvedTitle}}</div>
        <div class="prompt-actor-name">{{localize "ROE.RollSession.PrepareModifiers"}}</div>
    </header>
    {{#each preparationParticipants}}
    <div class="prompt-sub-box">
        <div class="combined-check-row"><span>{{actorName}}</span><strong>{{preparationLabel}}</strong></div>
        {{> roeModifierSlider manualModifierDice=modifierDice effectiveModifierLabel=modifierDisplay flagModifierDice=0 participantKey=key}}
    </div>
    {{/each}}
    {{#if preparationTactics.length}}
    <div class="section-header">{{localize "ROE.Combat.BonusDiceSection"}}</div>
    <div class="tactical-flags-grid">
        {{#each preparationTactics}}
        <button type="button" class="tab-btn tactical-toggle {{#if active}}active{{/if}}" data-action="togglePreparedTactical" data-flag="{{key}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{label}}</button>
        {{/each}}
    </div>
    {{/if}}
    <button type="button" class="prompt-action-btn primary" data-action="publishPreparedRoll">
        <i class="fa-solid fa-paper-plane"></i> {{localize "ROE.RollSession.SendPreparedRoll"}}
    </button>
</div>
