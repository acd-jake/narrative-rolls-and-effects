<div class="roe-roll-prompt-frame" style="background-color: {{themeBackgroundColor}}; --roe-frame-image: url('/modules/narrative-rolls-and-effects/assets/ui/{{theme}}/frame.svg');">
    <button type="button" class="prompt-close-btn" data-action="closePrompt" title="{{localize 'ROE.RollSession.Close'}}">
        <i class="fa-solid fa-xmark"></i>
    </button>
    <header class="prompt-header prompt-drag-handle">
        {{#if modifierPreparationHeaderPartial}}
        {{> (lookup . "modifierPreparationHeaderPartial")}}
        {{/if}}
    </header>
    {{#if modifierPreparationDetailsPartial}}
    {{> (lookup . "modifierPreparationDetailsPartial")}}
    {{/if}}
    <button type="button" class="prompt-action-btn primary" data-action="publishPreparedRoll">
        <i class="fa-solid fa-paper-plane"></i> {{localize "ROE.RollSession.SendPreparedRoll"}}
    </button>
</div>
