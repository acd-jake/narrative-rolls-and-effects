{{#if dice.length}}
<div class="prompt-dice-visuals" aria-label="{{localize 'ROE.Dice.DiceUsed'}}">
    {{#each dice}}
    <span class="prompt-die">
        <img src="{{src}}" alt="{{localize label}}" />
        {{#if multiple}}<span class="prompt-die-count">&times;{{count}}</span>{{/if}}
    </span>
    {{/each}}
</div>
{{/if}}
