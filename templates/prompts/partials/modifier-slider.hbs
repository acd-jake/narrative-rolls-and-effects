<div class="section-header">{{localize "ROE.Combat.AdditionalDice"}} ({{effectiveModifierLabel}})</div>
<div class="slider-control-block">
    <div class="slider-labels">
        <span>{{localize "ROE.Roll.PenaltyDice"}}</span>
        <span>0</span>
        <span>{{localize "ROE.Roll.BonusDice"}}</span>
    </div>
    <input type="range" name="modifierSlider" min="-2" max="2" step="1" value="{{manualModifierDice}}"
        data-flag-bonus="{{flagModifierDice}}" data-participant-key="{{participantKey}}" />
    <div class="slider-ticks">
        <span>-2</span><span>-1</span><span>0</span><span>+1</span><span>+2</span>
    </div>
</div>
