<div class="roe-overlay roe-chat-card {{#if isResolved}}is-resolved{{/if}}">
    <header class="chat-card-title">
        <strong>{{title}}</strong>
        <span>{{rollTypeLabel}}</span>
    </header>

    {{#if participants.length}}
    <div class="result-badge-row">
        {{#each participants}}
        <div class="participant-row" data-participant-key="{{key}}">
            <span class="participant-label">{{label}}</span>
            <span class="roll-badge {{successLevel}}">
                {{#if hasRolled}}{{total}}{{else}}{{localize "ROE.RollSession.PendingRoll"}}{{/if}}
            </span>
        </div>
        {{/each}}
    </div>
    {{/if}}

    {{#if isResolved}}
    <div class="result-section">
        <div class="section-body">{{outcomeHeadline}}</div>
    </div>
    {{/if}}
</div>
